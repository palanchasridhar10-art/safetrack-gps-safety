# ==== Application ====
APP_NAME=SafeTrack
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5500

# ==== Database ====
# SQLite for local/dev prototype. Swap for a PostgreSQL URL in production, e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/safetrack
DATABASE_URL=sqlite:///./safetrack.db

# ==== Security / JWT ====
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_SESSION_TOKEN_EXPIRE_MINUTES=10

# ==== OTP ====
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# ==== Email (SMTP) ====
# Used to send OTP codes. Leave blank in dev to fall back to console logging only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=SafeTrack <no-reply@safetrack.example>
EMAIL_USE_TLS=true

# ==== WhatsApp ====
# Official WhatsApp Business Platform / Cloud API credentials.
# If left blank, the backend falls back to generating "wa.me" click-to-chat
# links that the user (not the server) sends manually — no message is sent
# automatically and no personal WhatsApp account is automated or scraped.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0

# ==== Rate limiting ====
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_OTP=5/minute
RATE_LIMIT_SOS=3/minute
